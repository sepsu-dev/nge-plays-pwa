# Copy to `.env.local` for local runs, or paste the same keys into
# Vercel → Project → Settings → Environment Variables (Production + Preview).
#
# Everything here is optional for search; playback on a datacenter IP (Vercel) needs at
# least YOUTUBE_COOKIE + YOUTUBE_VISITOR_DATA, and ideally a reachable PO token provider.

# --- Sign-in session (the actual fix for "Sign in to confirm you're not a bot") ---------
# Full Cookie header of a signed-in youtube.com session. Must include VISITOR_INFO1_LIVE.
# Keep this secret: it is an account session, not a public token.
YOUTUBE_COOKIE=

# Visitor data that belongs to the same session/cookie (the VISITOR_INFO1_LIVE value).
# A PO token is only accepted for the visitor it was minted for.
YOUTUBE_VISITOR_DATA=

# --- PO token provider (lifts the ~512 KB range limit and helps with bot checks) --------
# Public HTTPS endpoint of a bgutil-ytdlp-pot-provider server. On Vercel this CANNOT be
# 127.0.0.1 — the provider has to run somewhere reachable from the function.
YT_PO_TOKEN_PROVIDER_URL=

# Optional `authorization` header sent verbatim to the provider (shared secret/gateway).
YT_PO_TOKEN_PROVIDER_AUTH=

# --- Static PO tokens (fallback when no provider is available) -------------------------
# Both must be set together; a token without its visitor data is ignored.
YOUTUBE_PO_TOKEN=
YOUTUBE_PO_TOKEN_YTMUSIC=
YOUTUBE_PO_TOKEN_IOS=

# --- Misc ------------------------------------------------------------------------------
YT_LANG=id
YT_LOCATION=ID
# Only useful on a host with a persistent filesystem (not Vercel serverless).
# YT_CACHE_DIR=.next/cache/yt
